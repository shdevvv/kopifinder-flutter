NODE_ENV=development
PORT=3000

# Supabase Credentials (Required for Phase 2+)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI API Key (Required for Phase 4)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Security & CORS (comma-separated allowlist; leave empty for native/Postman-only deployments)
CORS_ORIGINS=
ADMIN_USER_IDS=
AI_RATE_LIMIT_PER_HOUR=10

# OSM Sync Admin Token (Phase 3) — set a random secret string
ADMIN_SYNC_TOKEN=your-random-secret-token-for-sync-trigger
